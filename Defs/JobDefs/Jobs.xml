<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <JobDef>
    <defName>SmarterBeds_NegotiateRoom</defName>
    <driverClass>SmarterBeds.JobDriver_NegotiateRoom</driverClass>
    <reportString>negotiating for a better room with TargetA.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <joyDuration>600</joyDuration>
    <joySkill>Social</joySkill>
    <joyXpPerTick>0.01</joyXpPerTick>
    <joyKind>Social</joyKind>
  </JobDef>
  <!-- Last resort for a colonist with no bed: doze off in a chair. See ChairSleep.cs. -->
  <JobDef>
    <defName>SmarterBeds_SleepInChair</defName>
    <driverClass>SmarterBeds.JobDriver_SleepInChair</driverClass>
    <reportString>dozing in a chair.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
    <neverShowWeapon>true</neverShowWeapon>
  </JobDef>
</Defs>
