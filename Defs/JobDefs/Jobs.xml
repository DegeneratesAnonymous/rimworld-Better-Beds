<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <JobDef>
    <defName>WilsBetterBeds_NegotiateRoom</defName>
    <driverClass>WilsBetterBeds.JobDriver_NegotiateRoom</driverClass>
    <reportString>negotiating for a better room with TargetA.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <joyDuration>600</joyDuration>
    <joySkill>Social</joySkill>
    <joyXpPerTick>0.01</joyXpPerTick>
    <joyKind>Social</joyKind>
  </JobDef>
  <!-- The colonist being asked stops and listens (see TalkHold in NegotiateRoom.cs). Their old job
       resumes afterwards. -->
  <JobDef>
    <defName>WilsBetterBeds_ListenToRoomPitch</defName>
    <driverClass>WilsBetterBeds.JobDriver_ListenToPitch</driverClass>
    <reportString>listening to TargetA.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <neverShowWeapon>true</neverShowWeapon>
  </JobDef>

  <!-- Last resort for a colonist with no bed: doze off in a chair. See ChairSleep.cs. -->
  <JobDef>
    <defName>WilsBetterBeds_SleepInChair</defName>
    <driverClass>WilsBetterBeds.JobDriver_SleepInChair</driverClass>
    <reportString>dozing in a chair.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
    <neverShowWeapon>true</neverShowWeapon>
  </JobDef>
</Defs>
