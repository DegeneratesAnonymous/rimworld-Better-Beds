<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Smarter Beds</name>
  <author>YOUR_NAME</author>
  <packageId>yourname.smarterbeds</packageId>
  <supportedVersions>
    <li>1.6</li>
    <li>1.7</li>
  </supportedVersions>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <!-- Load after the mods that also touch beds, so our checks see their rules. -->
    <li>Ludeon.RimWorld.Royalty</li>
    <li>Ludeon.RimWorld.Ideology</li>
    <li>OskarPotocki.VanillaFactionsExpanded.Core</li>
    <li>Orion.Hospitality</li>
    <li>Jaxe.Bubbles</li>
  </loadAfter>
  <description>Colonists without a bed claim the best free private bedroom instead of the nearest bed. Mark any bed as "overflow" and it is only used when nothing better is free.

Prisoner, guest, slave, medical, and child bed logic is left to vanilla.</description>
</ModMetaData>
