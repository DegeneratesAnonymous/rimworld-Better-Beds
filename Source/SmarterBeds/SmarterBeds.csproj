<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build for one game version at a time:
      dotnet build -c Release                     (1.7, the default)
      dotnet build -c Release -p:GameVersion=1.6
    1.7 runs on Ludeon's Waylith engine (.NET 10); 1.6 runs on Unity (.NET Framework 4.7.2).
  -->
  <!-- GameVersion defaults to 1.7 in ../Directory.Build.props. -->

  <PropertyGroup Condition="'$(GameVersion)' == '1.7'">
    <TargetFramework>net10.0</TargetFramework>
    <RimWorldRefVersion>1.7.4990-unstable</RimWorldRefVersion>
    <HarmonyVersion>3.0.0-rc.3</HarmonyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GameVersion)' == '1.6'">
    <TargetFramework>net472</TargetFramework>
    <RimWorldRefVersion>1.6.4871</RimWorldRefVersion>
    <HarmonyVersion>2.4.3</HarmonyVersion>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmarterBeds</RootNamespace>
    <AssemblyName>SmarterBeds</AssemblyName>
    <OutputPath>../../$(GameVersion)/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Lets code branch on version: #if RW_1_7 ... #endif -->
    <DefineConstants>$(DefineConstants);RW_$(GameVersion.Replace('.', '_'))</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Never compile generated files from the other version's obj folder. -->
    <Compile Remove="obj/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game reference assemblies: builds without a RimWorld install (CI-friendly). -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldRefVersion)" />
    <!-- Compile against Harmony; players get it at runtime from the Harmony mod. -->
    <PackageReference Include="Lib.Harmony" Version="$(HarmonyVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameVersion)' == '1.6'">
    <!-- Lets net472 build on Linux/macOS runners. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
